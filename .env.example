# Copy to .env and fill in the key for whichever provider you select.
# Only the SELECTED provider's key is required.

# Which backend generates answers:  deepseek | openai | claude
RAG_PROVIDER=deepseek

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown):
# DeepSeek: deepseek-v4-flash (default) | deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash
# OPENAI_MODEL=gpt-4o-mini
# CLAUDE_MODEL=claude-opus-4-8
